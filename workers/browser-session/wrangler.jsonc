{
  "name": "webmcp-computer-browser-session",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "secrets": {
    "required": ["CF_ACCOUNT_ID", "GATEWAY_SIGNING_SECRET"]
  },
  "ratelimits": [
    {
      "name": "SESSION_RATE",
      "namespace_id": "1001",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "SESSION_ACTION_RATE",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
