{
  "name": "verbos-browser-session",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "account_id": "cf3d5b1eddd4c74d217780cdb7e55d07",
  "workers_dev": true,
  "unsafe": {
    "bindings": [
      {
        "name": "SESSION_RATE",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 4, "period": 60 }
      },
      {
        "name": "SESSION_ACTION_RATE",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  }
}
