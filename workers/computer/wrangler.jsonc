{
  "name": "webmcp-computer-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {
    "required": ["GATEWAY_SIGNING_SECRET"]
  },
  "containers": [
    {
      "class_name": "WebMCPComputerWorkspace",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 2,
      "rollout_active_grace_period": 0,
      "rollout_step_percentage": [100]
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "WebMCPComputerWorkspace" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WebMCPComputerWorkspace"] }
  ],
  "r2_buckets": [
    { "binding": "SITES", "bucket_name": "webmcp-computer-sites" }
  ],
  "ratelimits": [
    {
      "name": "EXEC_RATE",
      "namespace_id": "1012",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "PUBLISH_RATE",
      "namespace_id": "1010",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "WORKSPACE_WRITE_RATE",
      "namespace_id": "1011",
      // Fresh demo workspaces seed bundled manuals and demos. Keep enough
      // headroom for that one-time burst while still bounding sustained writes.
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
