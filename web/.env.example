# Server-side values for a non-Sites host. Never expose GATEWAY_SIGNING_SECRET
# through a VITE_ variable.
GATEWAY_SIGNING_SECRET=generate-with-openssl-rand-base64-48
BROWSER_WORKER_URL=https://browser.example.com
COMPUTER_WORKER_URL=https://computer.example.com

# Optional local Vite overrides. Both Workers must use matching gateway secret.
WEBMCP_COMPUTER_DEV_GATEWAY_SIGNING_SECRET=webmcp-computer-local-development-gateway-secret-do-not-use-in-production
VITE_BROWSER_WORKER_URL=http://127.0.0.1:8787
VITE_COMPUTER_WORKER_URL=http://127.0.0.1:8788
