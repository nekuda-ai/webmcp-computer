# Server-side values for the site backend (OpenAI Sites secrets or another host's env).
# Never expose GATEWAY_SIGNING_SECRET through a VITE_ variable.
GATEWAY_SIGNING_SECRET=generate-with-openssl-rand-base64-48
BROWSER_WORKER_URL=https://browser.example.com
COMPUTER_WORKER_URL=https://computer.example.com

# Local Vite overrides (`bun run dev` loads this file). These defaults expect both Workers
# to be running locally with the same development secret in their gitignored `.dev.vars`.
WEBMCP_COMPUTER_DEV_GATEWAY_SIGNING_SECRET=webmcp-computer-local-development-gateway-secret-do-not-use-in-production
VITE_BROWSER_WORKER_URL=http://127.0.0.1:8787
VITE_COMPUTER_WORKER_URL=http://127.0.0.1:8788

# Optional browser analytics. The project key is public build-time configuration, not a secret.
# Analytics and privacy-masked session replay stay off unless both values are non-empty.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
